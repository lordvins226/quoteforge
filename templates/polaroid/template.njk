<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ fontImports | safe }}
  <style>
    :root {
      {{ cssVars | safe }}
    }

    {{ baseCSS | safe }}
    {{ styleCSS | safe }}
  </style>
</head>
<body>
  <div class="card align-{{ card.align or 'center' }} polaroid">
    <div class="polaroid-plate">
      <div class="polaroid-well">
        {% for block in card.blocks %}
          {% if block.type == "image" %}
            {% include "_blocks/image.njk" %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="polaroid-caption">
        {% for block in card.blocks %}
          {% if block.type == "text" %}
            {% include "_blocks/text.njk" %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% include "_blocks/slide-counter.njk" %}
  </div>
</body>
</html>
