<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ fontImports | safe }}
  <style>
    :root {
      {{ cssVars | safe }}
    }

    {{ baseCSS | safe }}
    {{ styleCSS | safe }}
  </style>
</head>
<body>
  <div class="card align-{{ card.align or 'center' }} chat">
    {% for block in card.blocks %}
      {% if block.type == "headline" or block.type == "text" %}
        <div class="chat-meta">
          {%- if block.type == "headline" -%}
            {%- for part in block.parts -%}{{ renderPart(part) | safe }}{%- endfor -%}
          {%- else -%}
            {{ block.content }}
          {%- endif -%}
        </div>
      {% elif block.type == "bullet-list" or block.type == "callout" %}
        {%- for item in block.items %}
        <div class="chat-bubble {{ 'me' if item.label == 'me' else 'them' }}">{{ item.text }}</div>
        {%- endfor %}
      {% endif %}
    {% endfor %}

    {% include "_blocks/slide-counter.njk" %}
  </div>
</body>
</html>
