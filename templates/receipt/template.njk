<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ fontImports | safe }}
  <style>
    :root {
      {{ cssVars | safe }}
    }

    {{ baseCSS | safe }}
    {{ styleCSS | safe }}
  </style>
</head>
<body>
  <div class="card align-{{ card.align or 'center' }} receipt">
    {% for block in card.blocks %}
      {% if block.type == "headline" %}
        <div class="rc-head">
          <div class="rc-shop">
            {%- for part in block.parts -%}{{ renderPart(part) | safe }}{%- endfor -%}
          </div>
          {% if card.eyebrow %}<div class="rc-sub">{{ card.eyebrow }}</div>{% endif %}
        </div>
        <div class="rc-sep"></div>
      {% elif block.type == "bullet-list" or block.type == "callout" %}
        <div class="rc-rows">
          {%- for item in block.items %}
            {%- if not loop.last %}
            <div class="rc-row"><span>{{ item.text }}</span><span class="amt">{{ item.label }}</span></div>
            {%- endif %}
          {%- endfor %}
        </div>
        <div class="rc-sep"></div>
        {%- set total = block.items[block.items.length - 1] %}
        <div class="rc-total"><span>{{ total.text }}</span><span class="amt">{{ total.label }}</span></div>
        <div class="rc-sep"></div>
      {% elif block.type == "text" %}
        <div class="rc-foot">{{ block.content }}</div>
      {% endif %}
    {% endfor %}

    {% include "_blocks/slide-counter.njk" %}
  </div>
</body>
</html>
