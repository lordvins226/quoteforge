<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ fontImports | safe }}
  <style>
    :root {
      {{ cssVars | safe }}
    }

    {{ baseCSS | safe }}
    {{ styleCSS | safe }}
  </style>
</head>
<body>
  <div class="card align-{{ card.align or 'center' }} split">
    <div class="split-rail">
      {% if card.eyebrow %}
        <div class="split-rail-label">{{ card.eyebrow }}</div>
      {% endif %}
      {% if card.blocks[0].type == "headline" %}
        {% set block = card.blocks[0] %}
        {% include "_blocks/headline.njk" %}
      {% endif %}
    </div>
    <div class="split-main">
      {% for block in card.blocks %}
        {% if not (loop.first and block.type == "headline") %}
          {% if block.type == "headline" %}
            {% include "_blocks/headline.njk" %}
          {% elif block.type == "blockquote" %}
            {% include "_blocks/blockquote.njk" %}
          {% elif block.type == "text" %}
            {% include "_blocks/text.njk" %}
          {% elif block.type == "bullet-list" %}
            {% include "_blocks/bullet-list.njk" %}
          {% elif block.type == "callout" %}
            {% include "_blocks/callout.njk" %}
          {% elif block.type == "divider" %}
            {% include "_blocks/divider.njk" %}
          {% elif block.type == "spacer" %}
            {% include "_blocks/spacer.njk" %}
          {% elif block.type == "image" %}
            {% include "_blocks/image.njk" %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% include "_blocks/slide-counter.njk" %}
  </div>
</body>
</html>
