<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ fontImports | safe }}
  <style>
    :root {
      {{ cssVars | safe }}
    }

    {{ baseCSS | safe }}
    {{ styleCSS | safe }}
  </style>
</head>
<body>
  <div class="card align-{{ card.align or 'center' }} versus">
    {% set sidesRendered = false %}
    {% for block in card.blocks %}
      {% if (block.type == "bullet-list" or block.type == "callout") and not sidesRendered %}
        {%- set items = block.items %}
        <div class="vs {{ 'vs-solo' if items.length < 2 else '' }}">
          {% if items.length > 0 %}
          <div class="vs-side">
            <span class="vs-label">{{ items[0].label }}</span>
            <span class="vs-value">{{ items[0].text }}</span>
          </div>
          {% endif %}
          {% if items.length > 1 %}
          <div class="vs-rule"></div>
          <div class="vs-side right">
            <span class="vs-label">{{ items[1].label }}</span>
            <span class="vs-value">{{ items[1].text }}</span>
          </div>
          {% endif %}
        </div>
        {% set sidesRendered = true %}
      {% endif %}
    {% endfor %}

    {% include "_blocks/slide-counter.njk" %}
  </div>
</body>
</html>
