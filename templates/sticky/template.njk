<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ fontImports | safe }}
  <style>
    :root {
      {{ cssVars | safe }}
    }

    {{ baseCSS | safe }}
    {{ styleCSS | safe }}
  </style>
</head>
<body>
  <div class="card align-{{ card.align or 'center' }} sticky">
    {% set blockCount = card.blocks.length %}
    {% set hasSignature = blockCount > 1 and card.blocks[blockCount - 1].type == "text" %}
    <div class="sticky-note">
      {% for block in card.blocks %}
        {% if not (hasSignature and loop.last) %}
          {% if block.type == "headline" %}
            {% include "_blocks/headline.njk" %}
          {% elif block.type == "blockquote" %}
            {% include "_blocks/blockquote.njk" %}
          {% elif block.type == "text" %}
            {% include "_blocks/text.njk" %}
          {% elif block.type == "bullet-list" %}
            {% include "_blocks/bullet-list.njk" %}
          {% elif block.type == "callout" %}
            {% include "_blocks/callout.njk" %}
          {% elif block.type == "divider" %}
            {% include "_blocks/divider.njk" %}
          {% elif block.type == "spacer" %}
            {% include "_blocks/spacer.njk" %}
          {% elif block.type == "image" %}
            {% include "_blocks/image.njk" %}
          {% elif block.type == "stat" %}
            {% include "_blocks/stat.njk" %}
          {% elif block.type == "code" %}
            {% include "_blocks/code.njk" %}
          {% elif block.type == "chart" %}
            {% include "_blocks/chart.njk" %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if hasSignature %}
        <div class="sticky-sign">
          {% set block = card.blocks[blockCount - 1] %}
          {% include "_blocks/text.njk" %}
        </div>
      {% endif %}
    </div>

    {% include "_blocks/slide-counter.njk" %}
  </div>
</body>
</html>
